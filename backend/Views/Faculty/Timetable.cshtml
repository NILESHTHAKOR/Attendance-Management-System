@model TimetableFormViewModel
@{
    ViewData["Title"] = "My Timetable";
    ViewData["Active"] = "timetable";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var days = new[] { "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday" };
}

<div class="page-header">
    <h1 class="page-title"><i class="fa-solid fa-calendar-week"></i> My Weekly Timetable</h1>
</div>

@if (!Model.ExistingSlots.Any())
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="fa-solid fa-calendar-xmark fa-2x mb-2"></i>
            <p>No timetable slots assigned yet. Contact admin to add your schedule.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            @foreach (var day in days)
            {
                var slots = Model.ExistingSlots.Where(s => s.DayOfWeek == day).ToList();
                if (!slots.Any()) continue;
                <div class="timetable-day">
                    <div class="timetable-day-header">
                        <i class="fa-regular fa-calendar-check me-1"></i> @day
                    </div>
                    @foreach (var slot in slots)
                    {
                        <div class="timetable-slot">
                            <div>
                                <strong>@slot.Subject</strong>
                                <span class="text-muted small ms-2">@slot.ClassName · Semester @slot.SemesterNumber</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge badge-info">
                                    <i class="fa-regular fa-clock me-1"></i>@slot.StartTime – @slot.EndTime
                                </span>
                                <a asp-controller="Faculty" asp-action="MarkAttendance"
                                   asp-route-semesterId="@slot.SemesterId"
                                   asp-route-classId="@slot.ClassId"
                                   asp-route-subject="@slot.Subject"
                                   class="btn btn-sm btn-primary">
                                    <i class="fa-solid fa-pen-to-square"></i> Mark
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
