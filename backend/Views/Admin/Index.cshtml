@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fa-solid fa-shield-halved"></i> Admin Dashboard</h1>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--primary-light);">
            <i class="fa-solid fa-user-tie" style="color:var(--primary);"></i>
        </div>
        <div class="stat-body">
            <div class="stat-value">@Model.TotalFaculty</div>
            <div class="stat-label">Total Faculty</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#e0f2fe;">
            <i class="fa-solid fa-users" style="color:#0284c7;"></i>
        </div>
        <div class="stat-body">
            <div class="stat-value">@Model.TotalStudents</div>
            <div class="stat-label">Total Students</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#d1fae5;">
            <i class="fa-solid fa-book" style="color:#059669;"></i>
        </div>
        <div class="stat-body">
            <div class="stat-value">@Model.TotalSubjects</div>
            <div class="stat-label">Subjects</div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-user-tie"></i> Recent Faculty</span>
                <a asp-controller="Admin" asp-action="Faculty" class="btn btn-sm btn-outline">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table">
                    <thead><tr><th>Name</th><th>Email</th><th>Subject</th></tr></thead>
                    <tbody>
                    @foreach (var f in Model.RecentFaculty)
                    {
                        <tr>
                            <td>@f.Name</td>
                            <td class="text-muted small">@f.Email</td>
                            <td><span class="badge badge-info">@f.Subject</span></td>
                        </tr>
                    }
                    @if (!Model.RecentFaculty.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted">No faculty found</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-users"></i> Recent Students</span>
                <a asp-controller="Admin" asp-action="Students" class="btn btn-sm btn-outline">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table">
                    <thead><tr><th>Name</th><th>Roll No</th><th>Class</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.RecentStudents)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td class="text-muted small">@s.RollNo</td>
                            <td>@s.ClassName</td>
                        </tr>
                    }
                    @if (!Model.RecentStudents.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted">No students found</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
