@model List<AttendanceMS.Models.Subject>
@{
    ViewData["Title"] = "Manage Subjects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1 class="page-title"><i class="fa-solid fa-book"></i> Manage Subjects</h1>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><i class="fa-solid fa-plus-circle"></i> Add Subject</div>
            <div class="card-body">
                <form asp-action="CreateSubject" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">Subject Name</label>
                        <input type="text" name="subjectName" class="form-control"
                               placeholder="e.g. Database Management" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-plus"></i> Add Subject
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><i class="fa-solid fa-list"></i> All Subjects (@Model.Count)</div>
            <div class="card-body p-0">
                <table class="table">
                    <thead><tr><th>#</th><th>Subject Name</th><th>Created</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var (s, i) in Model.Select((s,i)=>(s,i+1)))
                    {
                        <tr>
                            <td class="text-muted">@i</td>
                            <td><i class="fa-solid fa-book-open text-muted me-1"></i> @s.SubjectName</td>
                            <td class="text-muted small">@s.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <form asp-action="DeleteSubject" method="post" style="display:inline"
                                      onsubmit="return confirm('Remove subject?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.SubjectId" />
                                    <button class="btn btn-sm btn-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No subjects yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
