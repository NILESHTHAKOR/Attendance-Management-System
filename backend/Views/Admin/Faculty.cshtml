@model List<AttendanceMS.Models.Faculty>
@{
    ViewData["Title"] = "Manage Faculty";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1 class="page-title"><i class="fa-solid fa-user-tie"></i> Manage Faculty</h1>
    <a asp-action="CreateFaculty" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Add Faculty
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var (f, i) in Model.Select((f,i) => (f,i+1)))
            {
                <tr>
                    <td class="text-muted">@i</td>
                    <td><strong>@f.Name</strong></td>
                    <td class="text-muted">@f.Email</td>
                    <td><span class="badge badge-info">@f.Subject</span></td>
                    <td class="text-muted small">@f.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-action="EditFaculty" asp-route-id="@f.FacultyId" class="btn btn-sm btn-outline">
                            <i class="fa-solid fa-pen"></i> Edit
                        </a>
                        <form asp-action="DeleteFaculty" method="post" style="display:inline"
                              onsubmit="return confirm('Remove this faculty member?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@f.FacultyId" />
                            <button class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No faculty added yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
