@model StudentReportViewModel
@{
    ViewData["Title"]  = "My Attendance Report";
    ViewData["Active"] = "report";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Attendance Report</h2>
        <p class="page-subtitle">@Model.StudentName · @Model.RollNo · Sem @Model.SemesterNumber · Class @Model.ClassName</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportExcel", new { subject = Model.FilterSubject, fromDate = Model.FilterFromDate?.ToString("yyyy-MM-dd"), toDate = Model.FilterToDate?.ToString("yyyy-MM-dd") })"
           class="btn btn-outline btn-sm">
            <i class="fa-solid fa-file-excel"></i> Export Excel
        </a>
    </div>
</div>

<!-- ══ Filter Form ══ -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="filter-form">
            <div class="filter-row">
                <div class="form-group">
                    <label class="form-label">Subject</label>
                    <select name="subject" class="form-control">
                        <option value="">All Subjects</option>
                        @foreach (var sub in Model.Subjects)
                        {
                            <option value="@sub"
                                    selected="@(Model.FilterSubject == sub)">
                                @sub
                            </option>}
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">From Date</label>
                    <input type="date" name="fromDate" class="form-control"
                           value="@Model.FilterFromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label class="form-label">To Date</label>
                    <input type="date" name="toDate" class="form-control"
                           value="@Model.FilterToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group align-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-filter"></i> Filter
                    </button>
                    <a href="@Url.Action("Report")" class="btn btn-outline">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ══ Overall Status Card ══ -->
<div class="stats-grid mb-4">
    <div class="stat-card stat-card-blue">
        <div class="stat-icon"><i class="fa-solid fa-percent"></i></div>
        <div class="stat-body">
            <div class="stat-value">@Model.OverallPercent.ToString("F1")%</div>
            <div class="stat-label">Overall (filtered)</div>
        </div>
    </div>
    <div class="stat-card stat-card-green">
        <div class="stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
        <div class="stat-body">
            <div class="stat-value">@Model.SubjectSummaries.Sum(s => s.Present)</div>
            <div class="stat-label">Total Present</div>
        </div>
    </div>
    <div class="stat-card stat-card-red">
        <div class="stat-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
        <div class="stat-body">
            <div class="stat-value">@Model.SubjectSummaries.Sum(s => s.Absent)</div>
            <div class="stat-label">Total Absent</div>
        </div>
    </div>
    <div class="stat-card stat-card-yellow">
        <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
        <div class="stat-body">
            <div class="stat-value">@Model.SubjectSummaries.Sum(s => s.Late)</div>
            <div class="stat-label">Total Late</div>
        </div>
    </div>
</div>

<!-- ══ Subject Summary Table ══ -->
@if (Model.SubjectSummaries.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title"><i class="fa-solid fa-table"></i> Subject Summary</h3>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Total</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <th>Late</th>
                        <th>Attendance %</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SubjectSummaries)
                    {
                        <tr class="@(s.Status == "blacklisted" ? "row-danger" : s.Status == "warning" ? "row-warning" : "")">
                            <td><strong>@s.Subject</strong></td>
                            <td>@s.TotalClasses</td>
                            <td class="text-green">@s.Present</td>
                            <td class="text-red">@s.Absent</td>
                            <td class="text-yellow">@s.Late</td>
                            <td>
                                <div class="progress-bar-wrapper">
                                    <div class="progress-bar-track">
                                        <div class="progress-bar-fill @(s.Status == "active" ? "fill-green" : s.Status == "warning" ? "fill-yellow" : "fill-red")"
                                             style="width:@(Math.Min((double)s.AttendancePercent,100))%"></div>
                                    </div>
                                    <span>@s.AttendancePercent.ToString("F1")%</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(s.Status == "active" ? "badge-active" : s.Status == "warning" ? "badge-warning" : "badge-danger")">
                                    @s.Status.ToUpperInvariant()
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ══ Detailed Attendance Log ══ -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-list"></i> Detailed Log</h3>
        <span class="badge badge-secondary">@Model.DetailRecords.Count records</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.DetailRecords.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-calendar-xmark"></i>
                <p>No records found for the selected filters.</p>
            </div>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Subject</th>
                        <th>Class</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.DetailRecords)
                    {
                        <tr>
                            <td>@r.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.Subject</td>
                            <td>Sem @r.SemesterNumber / @r.ClassName</td>
                            <td>
                                <span class="badge @(r.Status == "present" ? "badge-active" : r.Status == "late" ? "badge-warning" : "badge-danger")">
                                    <i class="fa-solid @(r.Status == "present" ? "fa-check" : r.Status == "late" ? "fa-clock" : "fa-xmark")"></i>
                                    @r.Status.ToUpperInvariant()
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
